# API Keys for Multi-Model Content Tester
# Copy this file to .env and fill in your API keys

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-your-openai-key-here

# Google (Gemini 2.0/2.5 Flash)
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic (Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google service account credentials (project-relative path)
# Only needed for src/upload_to_drive.py (standalone script, runs outside Claude Code).
# The Content Plan Google Sheet itself is read via the Google Drive MCP inside
# Claude Code — no credentials file needed for that.
# Default: credentials/google_sheets.json (folder is gitignored)
# GOOGLE_SHEETS_CREDENTIALS=/path/to/your/credentials.json
